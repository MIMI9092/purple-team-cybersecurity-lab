| makeresults
| eval event_code=0,event_account="",source_address="",result_code="",baseline=1
| append [ search index=main earliest=-30m latest=now host="AD-DC01" source="WinEventLog:Security" (EventCode=4768 OR EventCode=4771 OR EventCode=4624 OR EventCode=4625 OR EventCode=4648 OR EventCode=4672)
| eval event_code=tonumber(coalesce(EventCode,EventID)),account_value=if(event_code=4672,coalesce(SubjectUserName,Subject_User_Name,user,User),coalesce(TargetUserName,Target_User_Name,mvindex(Account_Name,0),user,User)),event_account=lower(replace(trim(account_value),"@.*$","")),source_address=replace(lower(trim(coalesce(IpAddress,Source_Network_Address,Client_Address,src_ip,SourceAddress))),"^::ffff:",""),result_code=upper(trim(coalesce(Status,Result_Code,Failure_Code))),baseline=0 ]
| eval runtime_target=lower(trim("$validate_current_ad_account_state.message.target_account")),containment_iso="$validate_current_ad_account_state.message.ad_action_request.planned_at",containment_epoch=strptime(substr(containment_iso,1,19)."+0000","%Y-%m-%dT%H:%M:%S%z")
| where baseline=1 OR (event_account=runtime_target AND isnotnull(containment_epoch) AND _time>=containment_epoch)
| stats sum(eval(if(baseline=0,1,0))) as total_authentication_events sum(eval(if(baseline=0 AND (event_code=4624 OR (event_code=4768 AND result_code IN ("","0","0X0"))),1,0))) as successful_authentication_events sum(eval(if(baseline=0 AND (event_code IN (4771,4625) OR (event_code=4768 AND result_code NOT IN ("","0","0X0"))),1,0))) as failed_or_denied_events sum(eval(if(baseline=0 AND event_code=4648,1,0))) as explicit_credential_events sum(eval(if(baseline=0 AND event_code=4672,1,0))) as privileged_session_events values(eval(if(baseline=0,source_address,null()))) as source_addresses values(eval(if(baseline=0,event_code,null()))) as event_codes
| eval runtime_target=lower(trim("$validate_current_ad_account_state.message.target_account")),containment_iso="$validate_current_ad_account_state.message.ad_action_request.planned_at",containment_epoch=strptime(substr(containment_iso,1,19)."+0000","%Y-%m-%dT%H:%M:%S%z"),verification_window_valid=if(isnotnull(containment_epoch) AND runtime_target!="","true","false")
| eval authentication_observation=case(verification_window_valid!="true","VERIFICATION_WINDOW_INVALID",successful_authentication_events>0,"SUCCESSFUL_AUTHENTICATION_OBSERVED_AFTER_RESPONSE",failed_or_denied_events>0,"FAILED_OR_DENIED_AUTHENTICATION_OBSERVED",total_authentication_events=0,"NO_POST_RESPONSE_AUTHENTICATION_EVENTS",true(),"POST_RESPONSE_IDENTITY_ACTIVITY_REQUIRES_REVIEW")
| table runtime_target authentication_observation verification_window_valid total_authentication_events successful_authentication_events failed_or_denied_events explicit_credential_events privileged_session_events source_addresses event_codes
